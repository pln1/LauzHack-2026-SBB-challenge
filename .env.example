# PostgreSQL (docker-compose uses the "db" service; locally use localhost)
DATABASE_URL=postgresql+asyncpg://sbb:sbb@localhost:5432/sbb

# Google Gemini (optional). Without a key the deterministic SBB rule engine answers.
GEMINI_API_KEY=
# Run `docker compose exec app python scripts/check_gemini.py` to benchmark the models your key can use,
# then paste the recommended GEMINI_MODEL / GEMINI_FALLBACK_MODEL lines here.
GEMINI_MODEL=gemini-3.8-flash
# One or more fallbacks, comma separated, tried in order on 503 "high demand", timeouts, 429 or 404.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# async: the SBB rules answer instantly and Gemini's wording replaces the text a few seconds later (recommended for demos).
# sync: the reply waits for Gemini (then use small timeouts, e.g. 25 / 12).
GEMINI_MODE=async
# schema | jsonschema | json. check_gemini.py tells you which is fastest for your key.
GEMINI_OUTPUT_MODE=schema
# Total wait per answer (all retries and models) and the limit for one call. Google rejects deadlines under 10 s.
GEMINI_TIMEOUT_SECONDS=50
GEMINI_ATTEMPT_TIMEOUT_SECONDS=25
GEMINI_RETRIES=1
GEMINI_RETRY_BACKOFF_SECONDS=1
GEMINI_MAX_OUTPUT_TOKENS=900
# minimal | low | medium | high (Gemini 3+ thinking effort; minimal is fastest)
GEMINI_THINKING_LEVEL=minimal

# Where the SBB "Daten" folder lives (extern-liveticker/, intern-liveticker/, Ereignismeldungen/)
DATA_DIR=./Daten
# Run the ETL automatically at startup when the database has no incidents
AUTO_INGEST=true
# Dataset window and number of curated "Live: Today" replay incidents
DATASET_FROM=2026-09-01
DATASET_TO=2026-10-13
LIVE_INCIDENT_COUNT=6

SESSION_TTL_HOURS=24
LOG_LEVEL=INFO
LOG_JSON=true
